# ==========================================
# NETFIL ERP - Backend .gitignore
# ==========================================

# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
*.pid
*.seed
*.pid.lock

# Uploads / user files
uploads/
storage/
public/uploads/

# Temporary files
tmp/
temp/
.cache/

# Testing / coverage
coverage/
.nyc_output/

# Build / generated files
dist/
build/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# Windows
ehthumbs.db
*.stackdump

# Environment-specific files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database files / local dumps
*.sql
*.sqlite
*.sqlite3
*.db

# Certificates / private keys
*.pem
*.key
*.crt
*.cer

# Backup files
*.bak
*.backup
*.old

# Miscellaneous
npm-packages-offline-cache/
.eslintcache
.stylelintcache